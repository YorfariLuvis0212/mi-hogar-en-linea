# Variables de entorno — Mi Hogar en Línea (nuevo sistema)
# Copia este archivo como `.env` y completa los valores reales.
# La validación se define en `src/lib/env.ts`.

# Cadena de conexión PostgreSQL (Neon en producción, PostgreSQL local en desarrollo).
DATABASE_URL="postgresql://usuario:clave@host:5432/mi_hogar_en_linea?sslmode=require"

# Secreto de firma de sesiones de better-auth. Cadena aleatoria de 32+ caracteres.
BETTER_AUTH_SECRET="genera-una-cadena-aleatoria-larga-y-unica"

# URL pública del servidor de autenticación.
BETTER_AUTH_URL="http://localhost:3000"

# URL pública de la aplicación (visible en el cliente).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

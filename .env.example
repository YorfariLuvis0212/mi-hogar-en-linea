# Mi Hogar en Línea — variables de entorno del monorepo.
#
# Copia este archivo a la ubicación que corresponde a cada aplicación y completa
# los valores. Los archivos .env reales nunca se versionan.

# ---------------------------------------------------------------------------
# packages/database (.env en packages/database)
# ---------------------------------------------------------------------------
# PostgreSQL. En producción usa la cadena de conexión de Neon;
# en desarrollo local, una instancia de PostgreSQL tradicional.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi_hogar_en_linea?sslmode=disable"

# ---------------------------------------------------------------------------
# apps/web (.env en apps/web)
# ---------------------------------------------------------------------------
# Debe coincidir con packages/database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi_hogar_en_linea?sslmode=disable"
# Secreto de better-auth: mínimo 16 caracteres. Genera uno distinto por entorno.
BETTER_AUTH_SECRET="dev-secret-cambiar-en-produccion-0000000000000000"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# apps/api (.env en apps/api)
# ---------------------------------------------------------------------------
# Debe coincidir con packages/database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mi_hogar_en_linea?sslmode=disable"
# Puerto donde escucha la API NestJS.
PORT="3001"
# URL pública del frontend, para CORS.
WEB_ORIGIN="http://localhost:3000"

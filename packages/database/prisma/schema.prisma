// Esquema de datos — Mi Hogar en Línea
// Marketplace inmobiliario de arrendamiento. Mercado inicial: Quibdó, Chocó.
// Base de datos: PostgreSQL (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidad y cuenta
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  phone         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      Account[]
  sessions      Session[]
  properties    Property[]
  favorites     Favorite[]
  participations ConversationParticipant[]
  messages      Message[]
  visitsRequested Visit[]     @relation("VisitRequester")
  visitsReceived  Visit[]     @relation("VisitHost")
  reportsFiled  Report[]      @relation("ReportReporter")
  blocksMade    Block[]       @relation("BlockAuthor")
  blocksReceived Block[]      @relation("BlockTarget")
  notifications Notification[]
  auditLogs     AuditLog[]
  leasesAsTenant Lease[]      @relation("LeaseTenant")
  leasesAsOwner  Lease[]      @relation("LeaseOwner")

  @@map("users")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Inmuebles y publicaciones
// ---------------------------------------------------------------------------

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  STUDIO
  COMMERCIAL
  LOT
}

enum ModerationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  RENTED
  PAUSED
}

model Property {
  id              String             @id @default(cuid())
  ownerId         String
  title           String
  description     String
  type            PropertyType
  moderationStatus ModerationStatus  @default(DRAFT)
  availability    AvailabilityStatus @default(AVAILABLE)

  price           Decimal            @db.Decimal(12, 2)
  bedrooms        Int                @default(0)
  bathrooms       Int                @default(0)
  parkingSpaces   Int                @default(0)
  areaM2          Int?

  // Ubicación: se expone a nivel de barrio; la dirección exacta es privada.
  city            String             @default("Quibdó")
  neighborhood    String
  addressLine     String?
  latitude        Float?
  longitude       Float?

  viewsCount      Int                @default(0)
  publishedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media     PropertyMedia[]
  favorites Favorite[]
  conversations Conversation[]
  visits    Visit[]
  lease     Lease?

  @@index([moderationStatus, availability])
  @@index([city, neighborhood])
  @@index([type])
  @@index([price])
  @@map("properties")
}

enum MediaType {
  IMAGE
  VIDEO
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  type       MediaType
  url        String
  altText    String?
  position   Int       @default(0)
  isCover    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_media")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Mensajería
// ---------------------------------------------------------------------------

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

model Conversation {
  id         String             @id @default(cuid())
  propertyId String
  status     ConversationStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  property     Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([propertyId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Visitas
// ---------------------------------------------------------------------------

enum VisitStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

model Visit {
  id          String      @id @default(cuid())
  propertyId  String
  requesterId String
  hostId      String
  status      VisitStatus @default(REQUESTED)
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requester User     @relation("VisitRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  host      User     @relation("VisitHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@map("visits")
}

// ---------------------------------------------------------------------------
// Confianza y seguridad
// ---------------------------------------------------------------------------

enum ReportTargetType {
  PROPERTY
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, targetType])
  @@map("reports")
}

model Block {
  id        String   @id @default(cuid())
  authorId  String
  targetId  String
  createdAt DateTime @default(now())

  author User @relation("BlockAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([authorId, targetId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Arrendamientos y contratos (evolución funcional)
// ---------------------------------------------------------------------------

enum LeaseStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

model Lease {
  id          String      @id @default(cuid())
  propertyId  String      @unique
  tenantId    String
  ownerId     String
  monthlyRent Decimal     @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  status      LeaseStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User      @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  owner    User      @relation("LeaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contract Contract?

  @@index([tenantId, status])
  @@map("leases")
}

enum ContractStatus {
  DRAFT
  GENERATED
  SIGNED
}

model Contract {
  id             String         @id @default(cuid())
  leaseId        String         @unique
  status         ContractStatus @default(DRAFT)
  generatedUrl   String?
  signedUrl      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Notificaciones y auditoría
// ---------------------------------------------------------------------------

enum NotificationType {
  MESSAGE
  VISIT
  MODERATION
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
